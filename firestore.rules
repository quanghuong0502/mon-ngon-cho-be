rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- User Validation ---
    function isValidUser(data) {
      return data.get('username', '') is string && data.get('username', '').size() <= 50
        && data.get('role', 'kid') in ['chef', 'kid']
        && data.get('name', '') is string && data.get('name', '').size() <= 200
        && (!data.keys().hasAny(['password']) || (data.password is string && data.password.size() >= 6))
        && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() < 2000))
        && (!data.keys().hasAny(['favorites']) || (data.favorites is list && data.favorites.size() <= 200))
        && (!data.keys().hasAny(['oneSignalIds']) || (data.oneSignalIds is list && data.oneSignalIds.size() <= 10))
        && (!data.keys().hasAny(['readNews']) || (data.readNews is list && data.readNews.size() <= 500));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isChef() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'chef';
    }

    match /users/{userId} {
      allow read: if true; 
      allow create: if isValidUser(incoming()) && isValidId(userId) && incoming().keys().hasAll(['username', 'role', 'name', 'createdAt']);
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
        incoming().get('username', '') == existing().get('username', '') &&
        incoming().get('role', 'kid') == existing().get('role', 'kid') &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'favorites', 'oneSignalIds', 'readNews', 'password']);
    }

    // --- Recipe Validation ---
    function isValidRecipe(data) {
      return data.get('title', '') is string && data.get('title', '').size() <= 200
        && data.get('description', '') is string && data.get('description', '').size() <= 2000
        && data.get('createdBy', '') is string
        && data.get('isPublished', true) is bool
        && (data.get('avgRating', 0) is number)
        && (data.get('totalRatings', 0) is number)
        && (data.get('favoriteCount', 0) is number);
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isChef() && isValidRecipe(incoming()) && isValidId(recipeId) && incoming().keys().hasAll(['title', 'description', 'createdBy', 'createdAt', 'isPublished']);
      allow update: if isSignedIn() && (
        // Chef can update everything
        (isChef() && isValidRecipe(incoming())) ||
        // Anyone signed in can increment/decrement favoriteCount
        (incoming().diff(existing()).affectedKeys().hasOnly(['favoriteCount']) && isValidRecipe(incoming()))
      );
      allow delete: if isChef();
    }

    // --- WeeklyMenu Validation ---
    function isValidMenu(data) {
      return data.keys().hasAll(['weekStart', 'slots'])
        && data.weekStart is string && data.weekStart.size() <= 20
        && data.slots is map && data.slots.keys().size() <= 10;
    }

    match /weeklyMenu/{menuId} {
      allow read: if true;
      allow create, update, delete: if isChef() && isValidMenu(incoming()) && isValidId(menuId);
    }

    // --- Order Validation ---
    function isValidOrder(data) {
      return data.keys().hasAll(['kidId', 'weekId', 'day', 'recipeId', 'recipeIds', 'status', 'createdAt', 'updatedAt'])
        && data.kidId is string && isValidId(data.kidId)
        && data.weekId is string && data.weekId.size() <= 20
        && data.day in ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']
        && data.recipeId is string && isValidId(data.recipeId)
        && data.recipeIds is list && data.recipeIds.size() > 0 && data.recipeIds.size() <= 10
        && data.status in ['pending', 'preparing', 'ready', 'on_the_way', 'arrived', 'done', 'cancelled']
        && (!data.keys().hasAny(['cancelReason']) || (data.cancelReason is string && data.cancelReason.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['itemAddedAt']) || data.itemAddedAt is map);
    }

    match /orders/{orderId} {
      allow read: if true; 
      allow create: if isValidOrder(incoming());
      allow update: if isValidOrder(incoming()) && (
        // Only allow status updates or recipe updates if pending or cancelled
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelReason']) ||
        ((existing().status == 'pending' || existing().status == 'cancelled') && 
         incoming().diff(existing()).affectedKeys().hasOnly(['recipeId', 'recipeIds', 'status', 'updatedAt', 'itemAddedAt', 'cancelReason'])))
      );
      allow delete: if existing().status == 'pending';
    }

    // --- News Validation ---
    function isValidNews(data) {
      return data.keys().hasAll(['title', 'content', 'createdBy', 'createdAt', 'isPinned', 'isPublished'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && data.content is string && data.content.size() <= 10000
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.isPinned is bool
        && data.isPublished is bool;
    }

    match /news/{newsId} {
      allow read: if resource.data.isPublished == true || isChef();
      allow create, update, delete: if isChef() && isValidNews(incoming());
    }

    // --- Review Validation ---
    function isValidReview(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorRole', 'comment', 'createdAt'])
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() <= 100
        && data.authorRole in ['chef', 'kid']
        && data.comment is string && data.comment.size() <= 2000
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['recipeId']) || (data.recipeId is string && isValidId(data.recipeId)))
        && (data.get('rating', 0) is number)
        && (data.get('parentId', '') is string)
        && (data.get('orderId', '') is string)
        && (data.get('imageUrls', []).size() <= 3);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview(incoming());
      allow update: if false; 
      allow delete: if false;
    }

    // --- Kitchen Config Validation ---
    function isValidKitchenConfig(data) {
      return data.keys().hasAll(['name', 'directions', 'mapsShareLink', 'openTime', 'closeTime', 'orderStartTime', 'orderEndTime', 'servingDays', 'readyMessage'])
        && data.name is string && data.name.size() > 0
        && data.directions is string
        && data.mapsShareLink is string
        && data.openTime is string
        && data.closeTime is string
        && data.orderStartTime is string
        && data.orderEndTime is string
        && data.servingDays is list
        && data.readyMessage is string;
    }

    match /config/main {
      allow read: if true;
      allow create, update, delete: if isChef() && isValidKitchenConfig(incoming());
    }

    // --- Achievement Validation ---
    function isValidAchievement(data, isCreate) {
      return (isCreate ? data.keys().hasAll(['title', 'isActive', 'logic', 'conditions']) : true)
        && (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() > 0 && data.title.size() <= 200))
        && (!data.keys().hasAny(['isActive']) || (data.isActive is bool))
        && (!data.keys().hasAny(['logic']) || (data.logic in ['AND', 'OR']))
        && (!data.keys().hasAny(['conditions']) || (data.conditions is list && data.conditions.size() > 0 && data.conditions.size() <= 4))
        && (!data.keys().hasAny(['description']) || data.description is string)
        && (!data.keys().hasAny(['emoji']) || data.emoji is string)
        && (!data.keys().hasAny(['order']) || data.order is number)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow create: if isValidAchievement(incoming(), true);
      allow update: if isValidAchievement(incoming(), false);
      allow delete: if true;
    }

    match /users/{userId}/unlockedAchievements/{achievementId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidId(achievementId)
        && incoming().keys().hasAll(['unlockedAt'])
        && incoming().unlockedAt is timestamp;
      allow delete: if false;
    }
  }
}
